{
  "root_domain": "qei.org.au",
  "canonical_host": "qei.org.au",
  "explicit_hosts": [
    "qei.org.au",
    "www.qei.org.au"
  ],
  "include_public_subdomains": true,
  "passive_certificate_discovery": true,
  "user_agent": "QEI-Authorised-Static-Mirror/1.0 (+https://qei.org.au/contact/)",
  "request_timeout_seconds": 25,
  "crawl_delay_seconds": 0.35,
  "max_sitemap_urls": 25000,
  "excluded_host_labels": [
    "admin",
    "api",
    "auth",
    "autoconfig",
    "autodiscover",
    "beta",
    "cpanel",
    "dev",
    "development",
    "ftp",
    "imap",
    "internal",
    "intranet",
    "mail",
    "mx",
    "pop",
    "remote",
    "secure",
    "smtp",
    "sso",
    "stage",
    "staging",
    "test",
    "vpn",
    "webmail",
    "whm"
  ],
  "excluded_path_patterns": [
    "/wp-admin",
    "/wp-login.php",
    "/xmlrpc.php",
    "/wp-json/",
    "/feed/",
    "/comments/feed/",
    "/trackback/"
  ],
  "tracking_host_fragments": [
    "doubleclick.net",
    "facebook.net",
    "google-analytics.com",
    "googletagmanager.com",
    "hotjar.com",
    "clarity.ms"
  ],
  "disable_forms": true,
  "disable_tracking": true,
  "add_noindex": true,
  "max_single_file_megabytes": 90,
  "max_total_download_megabytes": 1800,
  "disable_external_transactions": true,
  "transaction_words": [
    "donate",
    "donation",
    "payment",
    "checkout",
    "register",
    "registration",
    "refer-a-patient",
    "refer a patient",
    "send-enquiry",
    "send enquiry",
    "medical-record",
    "medical record",
    "book appointment",
    "book laser",
    "appointment booking"
  ],
  "transaction_host_fragments": [
    "stripe.com",
    "paypal.com",
    "donorbox.org",
    "raisely.com",
    "giveeasy.org",
    "mycause.com.au",
    "humanitix.com",
    "eventbrite.com",
    "myhealth1st.com.au"
  ]
}
